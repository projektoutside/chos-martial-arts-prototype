{
  "name": "chos-martial-arts-prototype",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:web:stable": "node scripts/build-web-stable.mjs",
    "build:web:testing": "node scripts/build-web-testing.mjs",
    "build:pages": "npm run build:web:stable && node scripts/write-build-version.mjs && node scripts/copy-spa-fallback.mjs",
    "build:cloudflare": "npm run build:web:stable && node scripts/write-build-version.mjs && node scripts/prepare-cloudflare-pages.mjs",
    "build:android": "npm run build:android:stable",
    "build:android:stable": "node scripts/build-android-variant.mjs stable",
    "build:android:testing": "node scripts/build-android-variant.mjs testing",
    "build:ios": "node scripts/build-ios.mjs stable",
    "build:ios:testing": "node scripts/build-ios.mjs testing",
    "preview": "vite preview",
    "preview:network": "vite preview --host 0.0.0.0",
    "test": "vitest run && npm run test:contracts",
    "test:contracts": "node --test scripts/activate-account-contract.test.mjs scripts/guided-onboarding-contract.test.mjs scripts/manager-create-account-contract.test.mjs scripts/own-student-record-contract.test.mjs scripts/prepare-ios-variant.contract.mjs scripts/prepare-testing-release.contract.mjs scripts/testing-store-workflow.contract.mjs scripts/validate-ios-release-input.contract.mjs scripts/validate-play-release-input.test.mjs scripts/verify-android-variant.test.mjs scripts/verify-demo-artifact.test.mjs scripts/verify-ios-release.contract.mjs",
    "test:e2e": "playwright test",
    "test:e2e:keyboard": "playwright test e2e/soft-keyboard-layout.spec.ts",
    "verify:android": "node scripts/verify-android-release.mjs",
    "verify:android:variants": "node --test scripts/verify-android-variant.test.mjs",
    "verify:demo-artifact": "node scripts/verify-demo-artifact.mjs dist",
    "verify:ios": "node scripts/verify-ios-release.mjs",
    "verify:ios:inputs": "node --test scripts/validate-ios-release-input.contract.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "8.4.1",
    "@supabase/supabase-js": "^2.108.1",
    "@vitejs/plugin-react": "6.0.1",
    "date-fns": "4.1.0",
    "lucide-react": "1.14.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.18.0",
    "vite": "8.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "25.6.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "playwright": "^1.61.1",
    "typescript": "6.0.3",
    "vitest": "4.1.5"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23",
    "tar": "7.5.22"
  }
}
